# Everything here is optional. With no keys, text PDFs are parsed from the text layer and
# scans are read with local OCR (RapidOCR): free and offline.

# --- OpenAI vision extraction, same stack as ai24c (OpenAI SDK + instructor, gpt-5-mini) ---
OPENAI_API_KEY=
# Leave empty for api.openai.com, or route through OpenRouter like ai24c:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=
# On OpenRouter the model id is e.g. openai/gpt-5-mini
OPENAI_MODEL=gpt-5-mini

# --- Claude (alternative provider) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# openai | anthropic | empty = whichever key is set (OpenAI first)
LLM_PROVIDER=

# --- Google Cloud Vision OCR for scans, as in ai24c (needs a GCP project with billing) ---
# Path to a service-account JSON. Unset -> local RapidOCR.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Team notifications (routed exceptions + SLA escalations). Unset -> shown in the in-app Outbox as "simulated".
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ap-autopilot@lumenretail.example
# Used for links inside notifications
APP_BASE_URL=http://localhost:8765

# --- Email intake. The drop folder (storage/inbox_drop) always works; IMAP turns on when these are set.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=60

# auto | llm | local
EXTRACTION_MODE=auto
# Pin "today" for date-age checks (YYYY-MM-DD). Empty = real date.
AP_TODAY=
